#include <winver.h>

// VER_MAJOR/MINOR/PATCH and VER_STR are passed in by build.rs.
1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Wireless Battery"
      VALUE "ProductName", "Wireless Battery"
      VALUE "FileVersion", VER_STR
      VALUE "ProductVersion", VER_STR
      VALUE "OriginalFilename", "WirelessBattery.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
